body {
  margin: 0;
  font-family: system-ui, -apple-system, sans-serif;
  background: #050509;
  color: #f5f5f5;
}

.site-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 32px;
  border-bottom: 1px solid #222;
}

.logo-block {
  display: flex;
  align-items: center;
  gap: 12px;
}

.name {
  font-weight: 800;
  color: #000;
  background: #f5f5f5;
  padding: 4px 8px;
}

.dna-helix {
  width: 24px;
  height: 60px;
  border-left: 2px solid #ff6fd8;
  border-right: 2px solid #4fd1ff;
  position: relative;
}

.dna-helix::before,
.dna-helix::after {
  content: "";
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 2px dashed rgba(255, 255, 255, 0.4);
}

nav a {
  margin: 0 8px;
  color: #f5f5f5;
  text-decoration: none;
  font-size: 0.9rem;
}

.hero {
  display: flex;
  padding: 48px 32px;
  gap: 32px;
}

.hero-left {
  max-width: 400px;
}

.hero-tag {
  font-size: 0.8rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #aaa;
}

.hero-line {
  margin-top: 8px;
  margin-bottom: 16px;
}

#enterPortfolio {
  padding: 10px 20px;
  border-radius: 999px;
  border: none;
  background: linear-gradient(90deg, #ff6fd8, #4fd1ff, #7cfb9b);
  color: #050509;
  font-weight: 600;
  cursor: pointer;
}

.hero-right {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.body-figure {
  width: 260px;
  height: 420px;
  border-radius: 999px;
  border: 1px solid #333;
  position: relative;
  overflow: hidden;
}

.flow {
  position: absolute;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 20% 0%, #ff6fd8, transparent 60%),
    radial-gradient(circle at 80% 30%, #4fd1ff, transparent 60%),
    radial-gradient(circle at 50% 80%, #7cfb9b, transparent 60%);
  opacity: 0.4;
  mix-blend-mode: screen;
}

.section {
  padding: 40px 32px;
  border-top: 1px solid #111;
}

.two-columns {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
  max-width: 800px;
}

.three-columns {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.card {
  padding: 16px;
  border-radius: 12px;
  background: #111;
}

.card.dark {
  background: linear-gradient(135deg, #111, #1b1030);
}

form input,
form textarea {
  width: 100%;
  max-width: 400px;
  margin-top: 4px;
  margin-bottom: 12px;
}
